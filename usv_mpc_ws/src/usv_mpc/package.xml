<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_mpc</name>
  <version>0.1.0</version>
  <description>MPC controller for dual-thruster USV (kinematic)</description>
  <maintainer email="user@example.com">USV Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- casadi: NMPC/QP 求解后端（mpc_kinematic/usv_model_kinematic）。
       pip-only，无 apt/rosdep key；见 setup.py install_requires。
       安装：pip install casadi -->
  <!-- acados: 可选的实时求解后端（mpc_kinematic_acados, kinematic.backend:=acados）。
       需源码构建 + pip install -e interfaces/acados_template，无 rosdep key；
       缺失时自动回退 IPOPT。见 docs/acados_migration.md -->

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
