<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_mpc</name>
  <version>0.1.0</version>
  <description>MPC controller for dual-thruster USV (kinematic + dynamic)</description>
  <maintainer email="user@example.com">USV Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- casadi: NMPC/QP solver backend (mpc_kinematic/mpc_dynamic/usv_model_*).
       pip-only — no apt/rosdep key exists. Declared in setup.py install_requires
       and usv_mpc_ws/requirements.txt. Install with:
         pip install -r usv_mpc_ws/requirements.txt   (or: pip install casadi)
       Intentionally NOT a rosdep key so `rosdep install` will not fail to resolve it. -->

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
