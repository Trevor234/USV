<?xml version="1.0"?>
<?xml-model href="../../package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_planning</name>
  <version>0.1.0</version>
  <description>Path planning for USV — waypoint management, fillet paths and speed profiles (C++ implementation)</description>
  <maintainer email="user@example.com">USV Developer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>yaml_cpp_vendor</depend>

  <!-- Eigen3 用于向量/矩阵运算，替代 Python numpy -->
  <build_depend>eigen</build_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
