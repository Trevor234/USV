<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_planning</name>
  <version>0.1.0</version>
  <description>Path planning for USV — waypoint management and Dubins paths</description>
  <maintainer email="user@example.com">USV Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>geographic_msgs</depend>

  <!-- Python runtime deps (rosdep-resolvable keys) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- casadi: OPTIONAL — only used by trajectory_optimizer.refine_min_curvature
       when enable_curvature_opt:=true (lazy-imported, guarded). pip-only, no
       rosdep key; see usv_mpc_ws/requirements.txt and setup.py extras_require. -->

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
