<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_simulation</name>
  <version>0.1.0</version>
  <description>
    Gazebo Sim / ROS 2 Jazzy simulation environment for the 2m dual-thruster USV.
    Provides SDF models, lake worlds, ArduPilot SITL bring-up scripts,
    and ROS 2 launch files for end-to-end MPC validation.
  </description>
  <maintainer email="user@example.com">USV Developer</maintainer>
  <license>MIT</license>

  <!-- Build -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime: ROS 2 message types used by the MPC stack -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <!-- Runtime: Gazebo Sim + ROS 2 bridge -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <!-- Runtime: Gazebo Classic legacy/fallback launches -->
  <exec_depend>gazebo_ros</exec_depend>

  <!-- Runtime: tf / URDF -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Runtime: MAVROS for the SITL bridge -->
  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>

  <!-- Sibling packages launched together -->
  <exec_depend>usv_mpc</exec_depend>
  <exec_depend>usv_planning</exec_depend>
  <exec_depend>usv_safety</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
