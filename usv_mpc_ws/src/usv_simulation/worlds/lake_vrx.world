<?xml version="1.0" ?>
<!--
  Lake world for USV simulation — VRX-activated variant.

  Differences from lake.world:
    - WavefieldModelPlugin ACTIVATED with parameters mirroring
      usv_simulation/config/gazebo_world.yaml::waves.
    - ocean_visual switched to a dynamic mesh driven by
      WavefieldVisualPlugin for animated water surface.

  Requires the following on GAZEBO_PLUGIN_PATH (built from external/vrx):
    - libWavefieldModelPlugin.so  (physics: surface z-displacement)
    - libWavefieldVisualPlugin.so (visual: animated mesh)
    - libwave_gazebo_common.so    (shared support; loaded automatically via RPATH)

  Used by:
    usv_simulation/launch/gazebo_only.launch.py (when vrx_enabled:=true)
    usv_simulation/launch/gazebo_sitl_full.launch.py (when vrx_enabled:=true)
-->
<sdf version="1.6">
  <world name="lake_world_vrx">

    <!-- ================ Physics ================ -->
    <physics name="default_physics" type="ode">
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>30.5419</latitude_deg>
      <longitude_deg>114.3645</longitude_deg>
      <elevation>23.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ================ Lighting ================ -->
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.9 1</background>
      <shadows>1</shadows>
      <fog>
        <color>0.7 0.8 0.9 1</color>
        <type>linear</type>
        <density>0.05</density>
        <start>50</start>
        <end>500</end>
      </fog>
    </scene>

    <!-- ================ Water surface (VRX wave-driven) ================ -->
    <!--
      The named="ocean_waves" must match <wave_model> referenced from
      the boat's usv_gazebo_dynamics_plugin so the same wavefield drives
      both surface displacement and per-cell buoyancy on the hull.

      Tune via usv_simulation/config/gazebo_world.yaml::waves and
      regenerate this world if you want different parameters.
    -->
    <model name="ocean_waves">
      <static>true</static>
      <link name="ocean_waves_link">
        <visual name="ocean_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.5 0.7</ambient>
            <diffuse>0.0 0.3 0.6 0.7</diffuse>
            <specular>0.4 0.4 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
          <!-- Visual wave deformation: re-tessellated each frame -->
          <plugin name="ocean_visual_plugin" filename="libWavefieldVisualPlugin.so">
            <static>false</static>
            <update_rate>30</update_rate>
            <size>2000 2000</size>
            <cell_count>50 50</cell_count>
            <wave>
              <number>3</number>
              <scale>1.5</scale>
              <angle>0.4</angle>
              <steepness>0.0</steepness>
              <amplitude>0.10</amplitude>
              <period>4.0</period>
              <direction>1 0</direction>
            </wave>
          </plugin>
        </visual>
      </link>

      <!-- Physics wavefield: gives z-displacement to the dynamics plugin.
           WavefieldModelPlugin is a ModelPlugin so it must sit under <model>,
           not <link>. -->
      <plugin name="wavefield_plugin" filename="libWavefieldModelPlugin.so">
        <static>false</static>
        <update_rate>30</update_rate>
        <size>2000 2000</size>
        <cell_count>50 50</cell_count>
        <wave>
          <model>PMS</model>
          <period>4.0</period>
          <number>3</number>
          <scale>1.5</scale>
          <gain>0.3</gain>
          <direction>1 0</direction>
          <angle>0.4</angle>
          <tau>2.0</tau>
          <amplitude>0.10</amplitude>
          <steepness>0.0</steepness>
        </wave>
        <markers>
          <wave_patch>false</wave_patch>
          <wave_patch_size>4 4</wave_patch_size>
        </markers>
      </plugin>
    </model>

    <!-- Submerged collision plane far below water for stability -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="seabed_link">
        <collision name="seabed_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================ Optional shoreline (visual only) ================ -->
    <model name="island_visual">
      <static>true</static>
      <pose>50 0 -1 0 0 0</pose>
      <link name="island_link">
        <visual name="island_visual">
          <geometry>
            <cylinder>
              <radius>10</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================ Wind ================ -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>

    <!-- ================ ROS bridge ================ -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

  </world>
</sdf>
