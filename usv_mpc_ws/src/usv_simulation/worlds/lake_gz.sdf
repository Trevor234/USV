<?xml version="1.0" ?>
<!-- Gazebo Sim (gz-sim8 / ROS 2 Jazzy) lake world for the USV fallback simulation. -->
<sdf version="1.9">
  <world name="lake_gz">
    <plugin filename="gz-sim8-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim8-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim8-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim8-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim8-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim8-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim8-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>30.5419</latitude_deg>
      <longitude_deg>114.3645</longitude_deg>
      <elevation>23.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ocean_visual">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ocean_link">
        <visual name="ocean_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.5 0.7</ambient>
            <diffuse>0.0 0.3 0.6 0.7</diffuse>
            <specular>0.4 0.4 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
        </visual>
      </link>
    </model>

    <model name="seabed">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="seabed_link">
        <collision name="seabed_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="seabed_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.12 0.07 1</ambient>
            <diffuse>0.25 0.18 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="island_visual">
      <static>true</static>
      <pose>50 0 -1 0 0 0</pose>
      <link name="island_link">
        <visual name="island_visual">
          <geometry>
            <cylinder>
              <radius>10</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
