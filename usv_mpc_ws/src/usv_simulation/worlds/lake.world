<?xml version="1.0" ?>
<!--
  Lake world for USV simulation.
  Provides:
    - Calm or wavy water surface (VRX wavefield plugin)
    - Wind disturbance (gazebo_ros_force_system)
    - Buoyancy datum at z = 0
    - Sky / sun lighting

  Used by:
    usv_simulation/launch/gazebo_only.launch.py
    usv_simulation/launch/gazebo_sitl_full.launch.py

  Tune wave/wind via env vars (substituted by xacro at launch time):
    USV_WAVE_AMPLITUDE       (default 0.0 → calm)
    USV_WAVE_PERIOD          (default 4.0)
    USV_WIND_X               (default 0.0)
    USV_WIND_Y               (default 0.0)

  See usv_simulation/config/gazebo_world.yaml for scenario presets.
-->
<sdf version="1.6">
  <world name="lake_world">

    <!-- ================ Physics ================ -->
    <physics name="default_physics" type="ode">
      <real_time_update_rate>250</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <!-- Spherical coordinates so GPS plugin emits sensible lat/lon -->
    <!-- Default location: Wuhan East Lake (a common Chinese USV test site) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>30.5419</latitude_deg>
      <longitude_deg>114.3645</longitude_deg>
      <elevation>23.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ================ Lighting ================ -->
    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.9 1</background>
      <shadows>1</shadows>
      <fog>
        <color>0.7 0.8 0.9 1</color>
        <type>linear</type>
        <density>0.05</density>
        <start>50</start>
        <end>500</end>
      </fog>
    </scene>

    <!-- ================ Water surface ================ -->
    <!--
      Two layers:
        - Visual:    blue plane at z = 0
        - Collision: very large flat plane (so spawn ray-casts hit something)

      Buoyancy is provided by libusv_gazebo_dynamics_plugin in the model SDF,
      not by ground_plane collision.  We only need a visual surface here.
    -->
    <model name="ocean_visual">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="ocean_link">
        <visual name="ocean_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2000 2000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.2 0.5 0.7</ambient>
            <diffuse>0.0 0.3 0.6 0.7</diffuse>
            <specular>0.4 0.4 0.6 1</specular>
          </material>
          <transparency>0.3</transparency>
        </visual>
      </link>
    </model>

    <!-- Submerged collision plane far below water for stability -->
    <model name="seabed">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="seabed_link">
        <collision name="seabed_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>4000 4000</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ================ Optional shoreline (visual only) ================ -->
    <model name="island_visual">
      <static>true</static>
      <pose>50 0 -1 0 0 0</pose>
      <link name="island_link">
        <visual name="island_visual">
          <geometry>
            <cylinder>
              <radius>10</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================ Wave field (VRX) ================ -->
    <!--
      Provides z-displacement of the water surface used by the per-model
      hydrodynamics plugin.  Disabled by default (amplitude 0); enable via
      gazebo_world.yaml presets in launch.

      DISABLED: requires osrf/vrx (libWavefieldPlugin.so) not installed.
    -->

    <!-- ================ Wind ================ -->
    <!--
      Built-in <wind> block (SDF native, not a plugin).  Sets a global
      wind vector that <link><enable_wind>true</enable_wind></link> bodies
      will react to via aerodynamic drag.  Currently zero; raise for §7.4
      robustness tests.

      The previous version of this file tried to load
      libgazebo_ros_force_system.so as a "wind_plugin" — that's not its
      purpose (it's a generic force-application bridge, not a wind model)
      and Gazebo rejected it as an "incorrect plugin type".
    -->
    <wind>
      <linear_velocity>0 0 0</linear_velocity>
    </wind>

    <!-- ================ ROS bridge ================ -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>10.0</update_rate>
    </plugin>

  </world>
</sdf>
