<?xml version="1.0"?>
<model>
  <name>usv_2m</name>
  <version>0.1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>USV MPC Project</name>
    <email>user@example.com</email>
  </author>

  <description>
    2-meter dual-thruster underactuated USV for the MPC control project.
    Hull mass 30 kg, Iz 8 kg·m², dual differential thrusters at ±0.3 m,
    instrumented with GPS / IMU / camera / 2D lidar, hydrodynamics
    matched to usv_model_dynamic.py (Fossen 3-DOF), bridged to ArduPilot
    SITL via the JSON FDM interface (libArduPilotPlugin.so).
  </description>
</model>
