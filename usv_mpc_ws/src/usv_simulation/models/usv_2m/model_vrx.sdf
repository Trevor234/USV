<?xml version="1.0" ?>
<!--
  USV 2m dual-thruster Gazebo Classic 11 model — VRX-activated variant.

  Differences from model.sdf (the fallback variant):
    - velocity_decay zeroed: VRX's usv_gazebo_dynamics_plugin provides
      Fossen damping; double-counting would over-damp the boat.
    - libBuoyancyPlugin (Gazebo built-in) REMOVED: VRX's dynamics plugin
      computes volume-fraction buoyancy from waterLevel + hull dims.
    - libusv_gazebo_dynamics_plugin ACTIVATED: real Fossen 3-DOF, reads
      wave_model from the world's Wavefield plugin.

  Same as fallback (unchanged):
    - Thrust is still applied via manual_force_plugin (libgazebo_ros_force.so)
      driven by usv_thrust_bridge → /usv/cmd_force (Wrench). We deliberately
      skip VRX's usv_gazebo_thrust_plugin because it's ROS-1-coupled in the
      upstream classic branch and porting it is out of scope.

  Requires the following on GAZEBO_PLUGIN_PATH (built from external/vrx):
    - libusv_gazebo_dynamics_plugin.so

  Coordinate convention: ENU world (Gazebo default), body x = forward,
  y = port (left), z = up.

  Parameters mirror usv_bringup/config/usv_params.yaml and
  usv_mpc/usv_mpc/usv_model_dynamic.py — keep all three in sync.
-->
<sdf version="1.6">
  <model name="usv_2m">

    <!-- Pose: spawned just above the water (z = 0 is water surface) -->
    <pose>0 0 0.05 0 0 0</pose>

    <!-- ============================== -->
    <!-- HULL (base_link)               -->
    <!-- ============================== -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <!--
        velocity_decay zeroed — Fossen damping comes from
        libusv_gazebo_dynamics_plugin below.
      -->
      <velocity_decay>
        <linear>0</linear>
        <angular>0</angular>
      </velocity_decay>

      <inertial>
        <mass>30.0</mass>
        <pose>0 0 -0.05 0 0 0</pose>
        <inertia>
          <!-- Hull treated as a 2.0 x 0.6 x 0.3 m box with corrected Izz=8 -->
          <ixx>1.5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>10.0</iyy>
          <iyz>0</iyz>
          <izz>8.0</izz>
        </inertia>
      </inertial>

      <!-- Visual: stylised hull (low-poly box; can be swapped for a mesh) -->
      <visual name="hull_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>2.0 0.6 0.3</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Cabin: small box on top so heading is visible in GUI -->
      <visual name="cabin_visual">
        <pose>0.2 0 0.2 0 0 0</pose>
        <geometry>
          <box><size>0.6 0.4 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.3 0.7 1</ambient>
          <diffuse>0.1 0.4 0.8 1</diffuse>
        </material>
      </visual>

      <!-- Collision: simple box matching visual -->
      <collision name="hull_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box><size>2.0 0.6 0.3</size></box>
        </geometry>
      </collision>

      <!-- ============================== -->
      <!-- IMU sensor                     -->
      <!-- ============================== -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros>
            <namespace>/usv</namespace>
            <remapping>~/out:=imu/data</remapping>
          </ros>
          <frame_name>base_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>

      <!-- ============================== -->
      <!-- GPS sensor                     -->
      <!-- ============================== -->
      <sensor name="gps_sensor" type="gps">
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <gps>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.10</stddev></noise></vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></vertical>
          </velocity_sensing>
        </gps>
        <plugin name="gps_plugin" filename="libgazebo_ros_gps_sensor.so">
          <ros>
            <namespace>/usv</namespace>
            <remapping>~/out:=gps/fix</remapping>
            <remapping>~/vel:=gps/vel</remapping>
          </ros>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ============================== -->
    <!-- LEFT thruster (port side)      -->
    <!-- ============================== -->
    <link name="left_thruster_link">
      <pose>-0.9 0.3 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.005</iyy><iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <visual name="left_thruster_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="left_thruster_collision">
        <geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
      </collision>
    </link>

    <joint name="left_thruster_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_thruster_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ============================== -->
    <!-- RIGHT thruster (starboard)     -->
    <!-- ============================== -->
    <link name="right_thruster_link">
      <pose>-0.9 -0.3 -0.05 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.005</iyy><iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <visual name="right_thruster_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="right_thruster_collision">
        <geometry><cylinder><radius>0.04</radius><length>0.15</length></cylinder></geometry>
        <pose>0 0 0 0 1.5708 0</pose>
      </collision>
    </link>

    <joint name="right_thruster_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_thruster_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- =================================================== -->
    <!-- VRX hydrodynamics (Fossen 3-DOF + volume buoyancy)   -->
    <!--                                                      -->
    <!-- Coefficients align with usv_bringup/config/          -->
    <!-- usv_params.yaml (signs flipped because VRX expects   -->
    <!-- positive damping magnitudes whereas Fossen convention-->
    <!-- in the MPC is negative).                             -->
    <!-- =================================================== -->
    <plugin name="usv_dynamics_plugin" filename="libusv_gazebo_dynamics_plugin.so">
      <bodyName>base_link</bodyName>
      <waterLevel>0.0</waterLevel>
      <waterDensity>997.8</waterDensity>
      <xDotU>3.0</xDotU>
      <yDotV>20.0</yDotV>
      <nDotR>2.0</nDotR>
      <xU>8.0</xU>
      <yV>30.0</yV>
      <nR>5.0</nR>
      <xUU>15.0</xUU>
      <yVV>60.0</yVV>
      <nRR>3.0</nRR>
      <hullRadius>0.30</hullRadius>
      <boatWidth>0.6</boatWidth>
      <boatLength>2.0</boatLength>
      <length_n>4</length_n>
      <wave_model>ocean_waves</wave_model>
    </plugin>

    <!-- =================================================== -->
    <!-- Manual force input — drives the boat from MPC via    -->
    <!-- usv_thrust_bridge → /usv/cmd_force (Wrench).         -->
    <!-- Kept unchanged from the fallback variant.            -->
    <!-- =================================================== -->
    <plugin name="manual_force_plugin" filename="libgazebo_ros_force.so">
      <ros>
        <namespace>/usv</namespace>
        <remapping>gazebo_ros_force:=cmd_force</remapping>
      </ros>
      <link_name>base_link</link_name>
      <force_frame>link</force_frame>
    </plugin>

    <!-- =================================================== -->
    <!-- ArduPilot bridge: JSON FDM over UDP                  -->
    <!-- Same as fallback variant — sim_vehicle.py talks to   -->
    <!-- this on 9002/9003 and the propeller spin is purely   -->
    <!-- visual; real thrust force comes from                 -->
    <!-- manual_force_plugin above.                           -->
    <!-- =================================================== -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <connectionTimeoutMaxCount>30</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 1.570796</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <!-- Channel 0 → left propeller spin (visual only) -->
      <control channel="0">
        <jointName>left_thruster_joint</jointName>
        <useForce>1</useForce>
        <multiplier>50</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>EFFORT</type>
        <p_gain>0.1</p_gain>
      </control>

      <!-- Channel 1 → right propeller spin (visual only) -->
      <control channel="1">
        <jointName>right_thruster_joint</jointName>
        <useForce>1</useForce>
        <multiplier>50</multiplier>
        <offset>-0.5</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>EFFORT</type>
        <p_gain>0.1</p_gain>
      </control>
    </plugin>

  </model>
</sdf>
