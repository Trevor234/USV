<?xml version="1.0"?>
<!-- LEGACY MODEL: retained only for reproducing old runs. vrx.launch.py now
     generates a native SDF with usv_simulation.vrx_model; this file is not loaded.
     The dimensions/mass below do not describe the identified 14.2 kg boat. -->
<!-- Single-hull, dual-thruster USV for VRX.

     Design goal: match the real 2 m / 30 kg differential-thrust boat while
     reusing the WAM-V's gz-sim thruster + sensor + buoyancy plugins, so the
     entire vrx_gz spawn/bridge pipeline and every /wamv/... topic the MPC
     depends on keep working unchanged. Only the HULL geometry/inertia and the
     thruster spacing change vs the WAM-V.

     vrx_gz Model.xacro_cmd() invokes this with:
       namespace:=wamv locked:=true vrx_sensors_enabled:=true
       ground_truth_enabled:=true thruster_config:=H
     Keep namespace = wamv so topics stay /wamv/... and the MPC needs no change. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="usv_mono">

  <!-- Args supplied by vrx_gz (declare all so xacro does not error on them) -->
  <xacro:arg name="namespace" default="wamv"/>
  <xacro:arg name="locked" default="false"/>
  <xacro:arg name="vrx_sensors_enabled" default="false"/>
  <xacro:arg name="ground_truth_enabled" default="true"/>
  <xacro:arg name="thruster_config" default="H"/>

  <xacro:property name="namespace" value="$(arg namespace)" scope="global"/>
  <xacro:property name="sensor_namespace" value="sensors/" scope="global"/>
  <xacro:property name="thruster_namespace" value="thrusters/" scope="global"/>

  <!-- VRX sensor + dynamics macros (wamv_imu, wamv_p3d, ...). We do NOT call
       the WAM-V usv_dynamics_gazebo macro; we use our own monohull dynamics. -->
  <xacro:include filename="$(find wamv_gazebo)/urdf/macros.xacro"/>

  <!-- ===================== Single hull ===================== -->
  <!-- 2.0 x 0.6 x 0.4 m box; mass 30 kg, Izz=8 to match usv_params.yaml MPC model.
       Ixx/Iyy from box approximation (m*(b^2+h^2)/12, m*(L^2+h^2)/12). -->
  <link name="${namespace}/base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.6 0.4"/></geometry>
    </visual>
    <collision name="hull_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="2.0 0.6 0.4"/></geometry>
    </collision>
    <inertial>
      <mass value="30.0"/>
      <!-- Principal moments must satisfy the triangle inequality (gz rejects
           otherwise). izz=8 matches usv_params Iz (yaw is what matters for a
           USV); ixx/iyy chosen so iyy <= ixx+izz holds. -->
      <inertia ixx="1.5" ixy="0.0" ixz="0.0" iyy="8.0" iyz="0.0" izz="8.0"/>
    </inertial>
  </link>

  <gazebo>
    <enable_wind>true</enable_wind>
  </gazebo>
  <gazebo reference="${namespace}/base_link">
    <visual>
      <material>
        <ambient>0.9 0.55 0.1 1</ambient>
        <diffuse>0.9 0.55 0.1 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- ===================== Buoyancy + hydrodynamics ===================== -->
  <xacro:include filename="$(find usv_simulation)/urdf/usv_mono_dynamics.xacro"/>
  <xacro:usv_mono_dynamics name="usv_mono_dynamics"/>

  <!-- ===================== Two thrusters @ y = +/-0.3 m ===================== -->
  <!-- Reuse the WAM-V engine + gz Thruster plugin so the thrust topics stay
       /wamv/thrusters/{left,right}/thrust (Newtons). Pods fixed forward =>
       differential drive. Position x at the stern of the 2 m hull. -->
  <xacro:include filename="$(find wamv_description)/urdf/thrusters/engine.xacro"/>
  <xacro:engine prefix="left"  position="-0.9 0.3 0.0"/>
  <xacro:engine prefix="right" position="-0.9 -0.3 0.0"/>

  <xacro:include filename="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_gazebo_thruster_config.xacro"/>
  <xacro:wamv_gazebo_thruster_config name="left"/>
  <xacro:wamv_gazebo_thruster_config name="right"/>

  <!-- ===================== Sensors (same topics as WAM-V) ===================== -->
  <!-- IMU -> /wamv/sensors/imu/imu/data ; P3D ground truth ->
       /wamv/sensors/position/ground_truth_odometry (what the MPC subscribes to). -->
  <xacro:if value="$(arg vrx_sensors_enabled)">
    <xacro:wamv_imu name="imu_wamv" y="0.0"/>
  </xacro:if>
  <xacro:if value="$(arg ground_truth_enabled)">
    <xacro:wamv_p3d name="p3d_wamv"/>
  </xacro:if>

  <!-- ===================== TF / joint states ===================== -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
    <plugin filename="libgz-sim-pose-publisher-system.so"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>false</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
  </gazebo>

</robot>
