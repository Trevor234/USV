<?xml version="1.0" ?>
<!--
  USV 2m URDF for robot_state_publisher / RViz visualization.

  This is a simplified (visual-only) tree that mirrors the SDF model
  geometry so /tf and RViz show a meaningful boat shape.  Physics in
  Gazebo come from model.sdf; this URDF is just for tf2.

  Spawn pattern:
    xacro usv_2m.urdf.xacro > /tmp/usv_2m.urdf
    robot_state_publisher /tmp/usv_2m.urdf
-->
<robot name="usv_2m" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="hull_length" value="2.0"/>
  <xacro:property name="hull_beam"   value="0.6"/>
  <xacro:property name="hull_height" value="0.3"/>
  <xacro:property name="d_thruster"  value="0.3"/>

  <!-- ================== base_link ================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${hull_length} ${hull_beam} ${hull_height}"/>
      </geometry>
      <material name="hull_white">
        <color rgba="0.95 0.95 0.95 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0.2 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
      <material name="cabin_blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="30.0"/>
      <inertia ixx="1.5" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="8.0"/>
    </inertial>
  </link>

  <!-- ================== imu_link ================== -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ================== gps_link ================== -->
  <link name="gps_link"/>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="gps_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- ================== camera_link ================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.10 0.05"/></geometry>
      <material name="camera_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.5 0 0.35" rpy="0 0 0"/>
  </joint>

  <!-- ================== lidar_link ================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.06" radius="0.04"/></geometry>
      <material name="lidar_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0.7 0 0.45" rpy="0 0 0"/>
  </joint>

  <!-- ================== thrusters ================== -->
  <xacro:macro name="thruster" params="name y_offset">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry><cylinder length="0.15" radius="0.04"/></geometry>
        <material name="thruster_grey"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <origin xyz="-0.9 ${y_offset} -0.05" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:thruster name="left_thruster"  y_offset="${ d_thruster}"/>
  <xacro:thruster name="right_thruster" y_offset="${-d_thruster}"/>

</robot>
