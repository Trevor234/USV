+  // only checked at the boundary would miss it.
+  const int64_t deadline = kStartNs + 1000000000;
+  Armed a(deadline, /*advance=*/1000000);
+  bool stop = false;
+  a.backend->attach_boundary(&a.boundary, [&] { return stop; });
+  a.boundary.set_entry_observer([&](const w2_wire::BoundaryConfig &) {
+    // The boundary has been reached and its release accepted; flip the stop
+    // now, which is inside the preparation window.
+    stop = true;
