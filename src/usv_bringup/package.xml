<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usv_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for USV MPC control system</description>
  <maintainer email="user@example.com">USV Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>ament_index_python</depend>
  <depend>mavros</depend>
  <depend>usv_mpc_cpp</depend>
  <depend>usv_planning_cpp</depend>
  <depend>usv_safety_cpp</depend>

  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>usv_mpc_kinematic_cpp</exec_depend>
  <exec_depend>ntrip_client</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
