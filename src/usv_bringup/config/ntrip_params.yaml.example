# CORS / NTRIP 连接参数 —— 供 ntrip_client 节点注入 RTK 差分(RTCM3)
#
# 使用方法:
#   cp ntrip_params.yaml.example ntrip_params.yaml
#   然后填写真实的 username / password。真实文件已被 .gitignore 忽略,
#   不得提交到仓库; 树莓派部署时通过 scp 单独传输。
#
# 服务商: 云图CORS (ytcors)
#
# 数据通路:
#   CORS caster --NTRIP/RTCM3--> ntrip_client
#     发布 rtcm(mavros_msgs/RTCM) --重映射--> /mavros/gps_rtk/send_rtcm
#     订阅 fix(sensor_msgs/NavSatFix) <--重映射-- /mavros/global_position/raw/fix
#   MAVROS gps_rtk 插件 --GPS_RTCM_DATA(MAVLink)--> MicoAir743 --GPS串口--> RTK模块
#
# /** 通配所有节点名 —— 与 mavros_config.yaml 同风格。
/**:
  ros__parameters:
    # —— CORS caster 地址 (云图CORS) ——
    host: gnss.ytcors.cn
    # 主用域名 gnss.ytcors.cn; 域名解析不了时改备用 IP: 101.52.241.18
    # 端口对应坐标基准: 8001=ITRF2008  8002=WGS84  8003=CGCS2000
    # 选 WGS84: 与 ArduPilot/GNSS 内部基准一致, 不引入基准转换偏差。
    # 若你的地图/任务底图用 CGCS2000(国测2000), 改成 8003。
    port: 8002
    # 源节点(挂载点): 优先 RTCM33GRCEJpro
    #   连不到接入点 → 备选 RTCM32GRCpro
    #   北斗在轨升级期老设备不固定 → 用 RTCM33GRC3EJpro (去除 B2)
    mountpoint: RTCM33GRCEJpro
    # —— 鉴权 (填写真实凭据, 不要提交) ——
    authenticate: true
    username: <你的CORS账号>
    password: <你的CORS密码>
    # NTRIP 协议版本: 默认 "None"(Ntrip 1.0); 连不上时改 "Ntrip/2.0"
    ntrip_version: None
    ssl: false
    rtcm_message_package: mavros_msgs
    qos_overrides:
      /fix:
        subscription:
          reliability: best_effort
          depth: 5
